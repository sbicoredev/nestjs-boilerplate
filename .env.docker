# ===== Application =====
APP_PREFIX="nestjs-boilerplate"
APP_PORT=3000
APP_VERSION="0.0.1"

# ===== Database =====
DB_PORT=5432
DB_NAME=nestjs-boilerplate
DB_USER=postgres
DB_PASSWORD=secret

# ===== Redis =====
REDIS_PORT=6379
REDIS_PASSWORD=pass
REDIS_INSIGHT_PORT=5540

# ===== Observability =====
PROMETHEUS_RETENTION_PERIOD=1 # automatically deletes any prometheus data older than 1 days
# ===== Grafana =====
GRAFANA_PORT=3001
GRAFANA_USERNAME=grafana
GRAFANA_PASSWORD=grafana

